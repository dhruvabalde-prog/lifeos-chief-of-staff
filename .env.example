# =========================================================================
# LifeOS: Autonomous Executive Chief of Staff - Environment Variables
# =========================================================================

# App Branding
NEXT_PUBLIC_APP_NAME="LifeOS: Autonomous Executive Chief of Staff"

# WhatsApp Cloud API Webhook Verification Token (Matches Meta Webhook Config)
WHATSAPP_VERIFY_TOKEN="lifeos_chief_of_staff_secure_token"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://lifeos-chief-of-staff.vercel.app"

# Google AI Studio / Gemini API Key (Optional: LifeOS falls back to heuristic engine if omitted)
GEMINI_API_KEY=""

# Google Workspace Integration OAuth Token (Optional: Mock simulation fallback active)
GOOGLE_WORKSPACE_ACCESS_TOKEN=""
